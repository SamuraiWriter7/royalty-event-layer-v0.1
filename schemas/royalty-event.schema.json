{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SamuraiWriter7/royalty-event-layer-v0.1/schemas/royalty-event.schema.json",
  "title": "Royalty Event Schema v0.1",
  "description": "A flexible schema for Royalty Event Layer v0.1 sample objects.",
  "type": "object",
  "required": ["royalty_event"],
  "additionalProperties": false,
  "properties": {
    "royalty_event": {
      "type": "object",
      "required": [
        "event_id",
        "version",
        "status",
        "event_type",
        "description",
        "source",
        "actor",
        "weighting",
        "review",
        "dispute",
        "downstream_use",
        "lifecycle",
        "safety_notes"
      ],
      "anyOf": [
        { "required": ["trace"] },
        { "required": ["trace_bundle"] }
      ],
      "additionalProperties": true,
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": ["sample", "draft", "experimental"]
        },
        "event_type": {
          "type": "string",
          "enum": [
            "access",
            "citation",
            "reuse",
            "influence",
            "allocation_trigger"
          ]
        },
        "description": {
          "type": "string"
        },
        "source": {
          "type": "object",
          "required": ["source_reference", "source_type", "title"],
          "additionalProperties": true,
          "properties": {
            "source_reference": { "type": "string" },
            "source_type": { "type": "string" },
            "title": { "type": "string" },
            "source_layer": { "type": "string" },
            "note": { "type": "string" }
          }
        },
        "trace": {
          "type": "object",
          "required": [
            "trace_reference",
            "trace_type",
            "trace_quality",
            "trace_timestamp"
          ],
          "additionalProperties": true,
          "properties": {
            "trace_reference": { "type": "string" },
            "trace_type": { "type": "string" },
            "trace_quality": { "type": "string" },
            "trace_timestamp": {
              "type": "string",
              "format": "date-time"
            },
            "trace_source_system": { "type": "string" },
            "evidence_summary": { "type": "string" }
          }
        },
        "trace_bundle": {
          "type": "object",
          "required": [
            "trace_bundle_reference",
            "trace_bundle_type",
            "trace_quality",
            "included_traces"
          ],
          "additionalProperties": true,
          "properties": {
            "trace_bundle_reference": { "type": "string" },
            "trace_bundle_type": { "type": "string" },
            "trace_quality": { "type": "string" },
            "trace_timestamp": {
              "type": "string",
              "format": "date-time"
            },
            "trace_source_system": { "type": "string" },
            "included_traces": {
              "type": "array",
              "items": { "type": "string" }
            },
            "evidence_summary": { "type": "string" }
          }
        },
        "event_bundle": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "event_bundle_reference": { "type": "string" },
            "event_bundle_type": { "type": "string" },
            "included_events": {
              "type": "array",
              "items": { "type": "string" }
            },
            "aggregate_weight": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "aggregate_confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "bundle_review_status": { "type": "string" },
            "bundle_dispute_status": { "type": "string" },
            "note": { "type": "string" }
          }
        },
        "actor": {
          "type": "object",
          "required": ["actor_type", "actor_reference", "actor_role"],
          "additionalProperties": true,
          "properties": {
            "actor_type": {
              "type": "string",
              "enum": [
                "human",
                "ai_agent",
                "platform",
                "system",
                "organization",
                "unknown"
              ]
            },
            "actor_reference": { "type": "string" },
            "actor_role": { "type": "string" },
            "note": { "type": "string" }
          }
        },
        "target": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "target_reference": {
              "type": ["string", "null"]
            },
            "target_type": {
              "type": ["string", "null"]
            },
            "target_title": {
              "type": ["string", "null"]
            },
            "note": {
              "type": "string"
            }
          }
        },
        "weighting": {
          "type": "object",
          "required": [
            "weight",
            "confidence",
            "allocation_relevance",
            "relevance_reason"
          ],
          "additionalProperties": true,
          "properties": {
            "weight": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "allocation_relevance": {
              "type": "string",
              "enum": [
                "none",
                "low",
                "medium",
                "high",
                "trigger_candidate"
              ]
            },
            "relevance_reason": {
              "type": "string"
            }
          }
        },
        "review": {
          "type": "object",
          "required": ["review_status", "review_type"],
          "additionalProperties": true,
          "properties": {
            "review_status": {
              "type": "string",
              "enum": [
                "pending",
                "approved",
                "approved_for_sample",
                "disputed",
                "rejected",
                "superseded"
              ]
            },
            "review_type": {
              "type": "array",
              "items": { "type": "string" }
            },
            "reviewer_reference": {
              "type": ["string", "null"]
            },
            "reviewed_at": {
              "type": ["string", "null"],
              "format": "date-time"
            },
            "review_notes": {
              "type": "string"
            }
          }
        },
        "dispute": {
          "type": "object",
          "required": [
            "dispute_status",
            "correction_path_available",
            "dispute_notes"
          ],
          "additionalProperties": true,
          "properties": {
            "dispute_status": {
              "type": "string",
              "enum": [
                "none",
                "contested",
                "suspended",
                "resolved",
                "reversed",
                "superseded"
              ]
            },
            "dispute_reference": {
              "type": ["string", "null"]
            },
            "correction_path_available": {
              "type": "boolean"
            },
            "reversal_path_required": {
              "type": "boolean"
            },
            "dispute_notes": {
              "type": "string"
            }
          }
        },
        "downstream_use": {
          "type": "object",
          "required": [
            "may_support",
            "should_not_directly_trigger",
            "note"
          ],
          "additionalProperties": true,
          "properties": {
            "may_support": {
              "type": "array",
              "items": { "type": "string" }
            },
            "should_not_directly_trigger": {
              "type": "array",
              "items": { "type": "string" }
            },
            "note": {
              "type": "string"
            }
          }
        },
        "lifecycle": {
          "type": "object",
          "required": ["current_state"],
          "additionalProperties": true,
          "properties": {
            "current_state": {
              "type": "string"
            },
            "previous_states": {
              "type": "array",
              "items": { "type": "string" }
            },
            "allowed_next_states": {
              "type": "array",
              "items": { "type": "string" }
            },
            "not_allowed_next_states_without_review": {
              "type": "array",
              "items": { "type": "string" }
            },
            "not_allowed_next_states_without_additional_review": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "safety_notes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
